# Destino del proxy de Vite para /api (la ruta se reenvía tal cual, bajo /api/v1).
# Fuera de Docker: localhost. Dentro de Docker compose: http://backend:8000
KAIROS_API_PROXY=http://localhost:8000
# true = las pantallas leen src/api/mocks/ en vez del backend (cuando T0-03 los genere)
VITE_USE_MOCKS=false
