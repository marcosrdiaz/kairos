# Copia este fichero a .env y rellena las claves. Sin claves la app arranca igual:
# el explicador usa plantillas con datos del motor y no hay audio (D-027).

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_DEEP=claude-sonnet-5-5

ELEVENLABS_API_KEY=
# Scribe v2 Realtime (T0-09)
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Flash v2.5 (T0-09). No normaliza cifras: voice/ las convierte a palabras antes del TTS
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Ciro, castellano peninsular (T0-09)
ELEVENLABS_VOICE_ID=ZmOvXLYy49UISWCUznMW

# offline | yahoo (D-065).
# - offline: todo sale de data/prices, sin red. Es el modo demo, el del guion.
# - yahoo: precios en directo (acciones, ETF y EUR/USD con 60 s de caducidad; VL de fondos cada 6 h),
#   guardados en BD. Para producción: DEMO_MODE=false, MARKET_DATA_PROVIDER=yahoo y DEMO_CLOCK vacío.
#   DEMO_MODE=false con offline no arranca.
# MARKET_DATA_API_KEY queda para un proveedor con clave futuro; yahoo no la usa.
MARKET_DATA_PROVIDER=offline
MARKET_DATA_API_KEY=

# Docker Compose lo sobrescribe con el host `db`. Para correr el backend fuera de Docker, usa localhost.
DATABASE_URL=postgresql+psycopg://kairos:kairos@localhost:5432/kairos

DEMO_MODE=true
# ISO 8601 con zona horaria para fijar la fecha. Vacío = reloj real.
# El guion usa el último cierre de data/prices, para que las cifras sean siempre las mismas.
DEMO_CLOCK=2026-11-06T18:00:00Z
